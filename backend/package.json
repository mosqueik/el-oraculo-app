{
  "name": "@el-oraculo/backend",
  "version": "1.0.0",
  "description": "El Oráculo Trading Engine — Node.js Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:load": "tsx tests/load/concurrent-coins.ts",
    "test:load:api": "tsx tests/load/api-load.ts",
    "test:load:memory": "tsx tests/load/memory-stress.ts",
    "test:load:all": "npm run test:load && npm run test:load:memory",
    "lint": "eslint src/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@el-oraculo/shared": "*",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "better-sqlite3": "^11.9.1",
    "binance": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.0",
    "node-cron": "^3.0.3",
    "stripe": "^22.6.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "technicalindicators": "^3.1.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.0",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}

# ═══════════════════════════════════════════════════════════════════
# EL ORÁCULO — Environment Variables (Production)
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ─── Binance API ────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ─── Backend ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────
# For Docker Compose: /app/data/oraculo.db (mounted volume)
# For Fly.io: /data/oraculo.db (persistent volume)
DB_PATH=/data/oraculo.db

# ─── Authentication ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret-in-production

# ─── Telegram Notifications (optional) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Redis (optional, for caching) ─────────────────────────────
# REDIS_URL=redis://redis:6379

# ─── Mobile App ─────────────────────────────────────────────────
# Set these in mobile/.env or in Expo environment
# EXPO_PUBLIC_API_URL=https://yourdomain.com
# EXPO_PUBLIC_WS_URL=https://yourdomain.com
